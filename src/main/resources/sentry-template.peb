{
{% if eventId is defined %}
    "event_id": "{{eventId}}",
{% endif %}
{% if timestamp is defined %}
    "timestamp": "{{timestamp}}",
{% endif %}
{% if platform is defined %}
    "platform": "{{platform}}",
{% endif %}
{% if level is defined %}
    "level": "{{level}}",
{% endif %}
{% if transaction is defined %}
    "transaction": "{{transaction}} /server",
{% endif %}
{% if serverName is defined %}
    "server_name": "{{serverName}} abigail",
{% endif %}
{# firstFailed is a task run when a task failed, `false` when the execution ended in another state, and absent when no task run matched. #}
{% set hasFailedTask = firstFailed is defined and firstFailed != false %}
{% if (not hasFailedTask) and errors is defined %}
    "errors": [
    {% for entry in errors %}
      {
         "type": "unknown_error",
         "path": "{{entry.key}}",
         "details": "{{entry.value}}"
      }{% if not loop.last %},{% endif %}
    {% endfor %}
    ],
{% endif %}
    "exception": {
      "values": [
        {
          "type": "{{execution.flowId}} ➛ {{execution.state.current}}",
          "value": "{% if hasFailedTask %}Failed on task `{{firstFailed.taskId}}`{% else %}Execution ended in {{execution.state.current}}{% endif %} after {{duration}}",
          "module": "{{execution.namespace}}",
          "stacktrace": {}
        }
      ]
    },
    "extra": {
        "Namespace": "{{execution.namespace}}",
        "Flow ID": "{{execution.flowId}}",
        "Execution ID": "{{execution.id}}",
        "Execution Status": "{{execution.state.current}}",
        {% if lastTask is defined %}
        "Final task ID": "{{lastTask.taskId}}",
        {% elseif execution.taskRunList is defined and execution.taskRunList is not empty %}
        {% set lastTaskRun = execution.taskRunList | last %}
        "Final task ID": "{{lastTaskRun.taskId}}",
        {% endif %}
        "Link": "{{link}}"
        {% if customMessage is defined %}
        ,"customMessage": {{ customMessage | toJson }}
        {% endif %}
        {% if customFields is defined and customFields is not empty %}
        {% for entry in customFields %}
        ,{{ entry.key | toJson }}: {{ entry.value | toJson }}
        {% endfor %}
        {% endif %}
        {% if extra is defined %}
        {% for entry in extra %}
        ,"{{entry.key}}": {{entry.value}}
        {% endfor %}
        {% endif %}
    }
}
